{
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0"
  },
  "lint-staged": {
    "*.go": "make fmt",
    "*.{css,html,json,jsonc,yaml,yml,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint"
    ]
  },
  "name": "skeeper",
  "packageManager": "bun@1.3.4",
  "private": true,
  "scripts": {
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "lint": "bun run format \u0026\u0026 bunx oxlint --no-error-on-unmatched-pattern '**/*.{ts,tsx,js,jsx,mjs,cjs}'",
    "prepare": "husky"
  },
  "version": "0.2.1"
}
